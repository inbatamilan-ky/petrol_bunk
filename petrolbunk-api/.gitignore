.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover

# -- Database --------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# -- Alembic local override ------------------------------------------------
alembic.local.ini

# -- Logs ------------------------------------------------------------------
*.log
logs/

# -- IDE & OS --------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
